<Window x:Class="LaserCalc.Desktop.Settings.CuttingParameterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaserCalc 2.0 | Schnittparameter"
        Height="650" Width="900" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterOwner" Background="{StaticResource NavyBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="MASCHINENSTAMMDATEN" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Schnittparameter nach Werkstoff und Blechdicke" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
            <TextBlock Text="Hinterlege hier deine tatsächlichen Erfahrungs- oder TruTops-Werte. Der Werkstoffname muss exakt dem Eintrag in der Materialauswahl entsprechen (z. B. Stahl, Edelstahl / VA, Aluminium). Es werden keine unbekannten Schnittgeschwindigkeiten automatisch erfunden." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12">
            <DataGrid x:Name="ParameterGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      Background="{StaticResource PanelBrush}" Foreground="#E8EEF3" RowBackground="#192633"
                      AlternatingRowBackground="#213242" BorderThickness="0" GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#213242"/><Setter Property="Foreground" Value="#B9C8D5"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="9,10"/></Style>
                    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,7"/><Setter Property="Foreground" Value="#E8EEF3"/></Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Werkstoff" Binding="{Binding MaterialName, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                    <DataGridTextColumn Header="Blechdicke (mm)" Binding="{Binding ThicknessMm, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="Vorschub (m/min)" Binding="{Binding FeedRateMetersPerMinute, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="Einstichzeit (s)" Binding="{Binding PierceSeconds, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Zeile hinzufügen" Background="#28577B" Click="AddButton_Click"/>
                <Button Content="Ausgewählte Zeile löschen" Background="#5B3540" Click="DeleteButton_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Background="#34495A" Click="CancelButton_Click"/>
                <Button Content="Parameter speichern" Padding="18,10" Click="SaveButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
