<Window x:Class="LaserCalc.Desktop.Settings.MaterialSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Materialstamm und interne Kosten" Height="590" Width="920"
        MinHeight="480" MinWidth="760" WindowStartupLocation="CenterOwner"
        Background="#101B27" Foreground="#EAF1F6">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="STAMMDATEN" Foreground="#78B8EA" FontSize="11" FontWeight="Bold"/>
            <TextBlock Text="Materialien &amp; Maschinen-Vollkosten" FontSize="24" FontWeight="Bold" Margin="0,5,0,4"/>
            <TextBlock Text="Preise und Dichten sind deine Material-Stammdaten. Der Maschinenstundensatz ist der interne Vollkostensatz – kein Kunden-Verkaufssatz. Alle Werte bleiben lokal auf diesem PC gespeichert." Foreground="#AAB9C6" TextWrapping="Wrap"/>
        </StackPanel>
        <DataGrid x:Name="MaterialGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True"
                  CanUserDeleteRows="True" CanUserReorderColumns="False" CanUserResizeRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                  Background="#172636" Foreground="#EAF1F6" RowBackground="#172636"
                  AlternatingRowBackground="#1D3042" BorderBrush="#344A5E" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#30475A" ColumnHeaderHeight="38" RowHeight="42"
                  FontSize="13" Margin="0,0,0,14">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#223B51"/>
                    <Setter Property="Foreground" Value="#D6E4EF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="9,6"/>
                    <Setter Property="BorderBrush" Value="#344A5E"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="#EAF1F6"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Werkstoff" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                <DataGridTextColumn Header="Materialpreis €/kg" Binding="{Binding PricePerKg, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Width="1.25*"/>
                <DataGridTextColumn Header="Dichte kg/m³" Binding="{Binding DensityKgPerM3, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}" Width="1.2*"/>
                <DataGridTextColumn Header="Interne Vollkosten €/h" Binding="{Binding MachineRatePerHour, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="1.5*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Mindestens ein Material muss vorhanden sein." Foreground="#90A5B6" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,14,0"/>
            <Button Grid.Column="1" Content="Abbrechen" MinWidth="110" Padding="14,9" Click="CancelButton_Click" Background="#263B4D" Foreground="White" BorderBrush="#42596E"/>
            <Button Grid.Column="3" Content="Änderungen speichern" MinWidth="180" Padding="14,9" Click="SaveButton_Click" Background="#2475B6" Foreground="White" BorderBrush="#3988C7" FontWeight="SemiBold"/>
        </Grid>
    </Grid>
</Window>
