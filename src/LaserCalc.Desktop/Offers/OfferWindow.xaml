<Window x:Class="LaserCalc.Desktop.Offers.OfferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaserCalc 2.0 | Kundenangebot erstellen"
        Height="940" Width="1120" MinHeight="760" MinWidth="940"
        WindowStartupLocation="CenterOwner" Background="{StaticResource NavyBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="VERKAUF · KUNDENANGEBOT" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold"/>
            <Grid Margin="0,5,0,0">
                <StackPanel>
                    <TextBlock Text="Angebot fertigstellen" Foreground="White" FontSize="27" FontWeight="Bold"/>
                    <TextBlock Text="Preise prüfen, Kundendaten ergänzen und ein versandfertiges PDF erzeugen." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="15,10">
                    <StackPanel>
                        <TextBlock Text="ANGEBOTSNUMMER" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold"/>
                        <TextBlock x:Name="OfferNumberText" Text="ANG-0000-0001" Foreground="#6FB8F0" FontSize="17" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="17" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="1 · ABSENDERDATEN" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Firma" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="CompanyNameBox"/>
                            <TextBlock Text="Straße / Hausnummer" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="CompanyStreetBox"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="PLZ" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="CompanyPostalBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Ort" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="CompanyCityBox"/></StackPanel>
                            </Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Telefon" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="CompanyPhoneBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="E-Mail" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="CompanyEmailBox"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Website" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="CompanyWebsiteBox"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="USt-IdNr. (optional)" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="VatIdBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Steuernummer (optional)" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="TaxNumberBox"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Bankverbindung (optional)" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="BankNameBox"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="IBAN" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="IbanBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="BIC" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="BicBox"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Diese Absenderdaten werden bei der Angebotserstellung für das nächste Mal gespeichert." Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="17">
                        <StackPanel>
                            <TextBlock Text="2 · KUNDENADRESSE" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Gespeicherte Kunden" Foreground="#C7D5E0" FontSize="10"/>
                            <ComboBox x:Name="CustomerPicker" DisplayMemberPath="DisplayName" SelectionChanged="CustomerPicker_SelectionChanged" Margin="0,0,0,7"/>
                            <TextBlock Text="Firma / Kunde *" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="CustomerNameBox"/>
                            <TextBlock Text="Ansprechpartner" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="CustomerContactBox"/>
                            <TextBlock Text="Straße / Hausnummer *" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="CustomerStreetBox"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="PLZ *" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="CustomerPostalBox"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Ort *" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="CustomerCityBox"/></StackPanel>
                            </Grid>
                            <TextBlock Text="E-Mail" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="CustomerEmailBox"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="17" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="3 · ANGEBOTSPOSITION" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                            <TextBlock Text="Betreff" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="SubjectBox"/>
                            <TextBlock Text="Positionsbeschreibung" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="DescriptionBox" Height="66" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Text="Übernommene Kalkulationsdaten" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,0,0,5"/>
                            <TextBlock x:Name="PartDetailsText" Text="Teil · Material · Dicke · Menge" Foreground="#BBD0DF" FontSize="10" TextWrapping="Wrap"/>
                            <Separator Background="#344554" Margin="0,12,0,10"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Menge" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="QuantityBox" TextChanged="QuantityBox_TextChanged"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Netto-Stückpreis (€)" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="UnitPriceBox" TextChanged="UnitPriceBox_TextChanged"/></StackPanel>
                            </Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Rabatt (%)" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="DiscountBox" Text="0" TextChanged="PricingInput_Changed"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Umsatzsteuer (%)" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="VatBox" Text="19" TextChanged="PricingInput_Changed"/></StackPanel>
                            </Grid>
                            <Border Background="#10202D" CornerRadius="8" Padding="12" Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="ANGEBOTSSUMME" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="NetTotalText" Text="Netto: –" Foreground="White" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                    <TextBlock x:Name="VatTotalText" Text="Umsatzsteuer: –" Foreground="#B8C8D5" FontSize="11"/>
                                    <TextBlock x:Name="GrossTotalText" Text="Brutto: –" Foreground="#6FB8F0" FontSize="22" FontWeight="Bold" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="PriceHintText" Text="Standardvorschlag ist der empfohlene Verkaufspreis aus der Kalkulation. Der Angebotspreis kann angepasst werden." Foreground="{StaticResource MutedBrush}" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="17">
                        <StackPanel>
                            <TextBlock Text="4 · KONDITIONEN" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,10"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Angebotsdatum" Foreground="#C7D5E0" FontSize="10"/><DatePicker x:Name="OfferDatePicker"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Gültigkeit (Tage)" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="ValidityDaysBox" Text="14"/></StackPanel>
                            </Grid>
                            <TextBlock Text="Lieferzeit / Lieferung" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="DeliveryBox"/>
                            <TextBlock Text="Zahlungsbedingungen" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="PaymentBox"/>
                            <TextBlock Text="Schlusstext" Foreground="#C7D5E0" FontSize="10"/><TextBox x:Name="ClosingTextBox" Height="54" TextWrapping="Wrap" AcceptsReturn="True"/>
                            <TextBlock Text="Hinweis: Die Angebots-PDF übernimmt die oben eingetragenen Daten. Bank-, Steuer- und Absenderangaben bitte vor dem ersten Versand vervollständigen." Foreground="#E6C47A" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="PDF wird lokal erzeugt. Die Angebotsdaten bleiben auf diesem Rechner." Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Background="#34495A" Click="CancelButton_Click"/>
                <Button Content="Angebot als PDF erstellen" Padding="18,10" Click="CreateOfferButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
